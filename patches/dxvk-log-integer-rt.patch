+  /**
+   * \brief Logs integer render target formats (diagnostic)
+   *
+   * D3D11 integer render targets must match the shader output type
+   * and cannot be blended, which makes them a likely source of
+   * validation errors or misrendering. Log the first time each
+   * distinct render target format, blend state and shader write mask
+   * combination is seen so that the UMD state can be correlated with
+   * the formats DXVK actually receives. The fragment shader output
+   * types are not tracked in DXVK's shader metadata, so the integer
+   * output property is reported as unknown.
+   */
+  static void logIntegerRenderTargets(
+    const DxvkGraphicsPipelineStateInfo& state,
+          uint32_t                       fsOutputMask) {
+    static const std::set<VkFormat> integerFormats = {
+      VK_FORMAT_R32_UINT, VK_FORMAT_R16_UINT, VK_FORMAT_R8_UINT,
+      VK_FORMAT_R32G32B32A32_UINT };
+
+    static std::set<uint64_t> logged;
+    static std::mutex loggedMutex;
+
+    for (uint32_t i = 0; i < MaxNumRenderTargets; i++) {
+      VkFormat format = state.rt.getColorFormat(i);
+
+      if (integerFormats.find(format) == integerFormats.end())
+        continue;
+
+      uint32_t blendEnable = state.omBlend[i].blendEnable();
+
+      uint64_t key = (uint64_t(uint32_t(format)) << 33)
+                   | (uint64_t(blendEnable) << 32)
+                   | uint64_t(fsOutputMask);
+
+      {
+        std::lock_guard<std::mutex> lock(loggedMutex);
+
+        if (!logged.insert(key).second)
+          continue;
+      }
+
+      Logger::info(str::format("DXVK int-RT diag: rt=", i,
+        " vkFormat=", uint32_t(format),
+        " blendEnable=", blendEnable,
+        " fsWritesRt=", (fsOutputMask >> i) & 1u,
+        " shaderOutputInteger=unknown"));
+    }
+  }
