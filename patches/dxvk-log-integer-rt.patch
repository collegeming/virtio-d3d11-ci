+  /**
+   * \brief Logs integer render target formats at render pass begin
+   *
+   * Companion to the pipeline-side diagnostic in dxvk_graphics.cpp:
+   * reports the color attachment formats that the framebuffer actually
+   * binds. Blend state is not known at this point, and DXVK does not
+   * track fragment shader output types, so both are reported as
+   * unknown. Each distinct attachment format is logged once.
+   */
+  static void logIntegerRenderPassTargets(const DxvkFramebufferInfo& fbInfo) {
+    static const std::set<VkFormat> integerFormats = {
+      VK_FORMAT_R32_UINT, VK_FORMAT_R16_UINT, VK_FORMAT_R8_UINT,
+      VK_FORMAT_R32G32B32A32_UINT };
+
+    static std::set<uint64_t> logged;
+    static std::mutex loggedMutex;
+
+    for (uint32_t i = 0; i < MaxNumRenderTargets; i++) {
+      VkFormat format = fbInfo.getColorFormat(i);
+
+      if (integerFormats.find(format) == integerFormats.end())
+        continue;
+
+      uint64_t key = (uint64_t(uint32_t(format)) << 32) | uint64_t(i);
+
+      {
+        std::lock_guard<std::mutex> lock(loggedMutex);
+
+        if (!logged.insert(key).second)
+          continue;
+      }
+
+      Logger::info(str::format("DXVK int-RT diag: renderpass rt=", i,
+        " vkFormat=", uint32_t(format),
+        " blendEnable=unknown shaderOutputInteger=unknown"));
+    }
+  }
