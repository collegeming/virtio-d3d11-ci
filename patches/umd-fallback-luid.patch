+        IDXGIAdapter1 *fallback = NULL;
+        HRESULT fallback_hr = IDXGIFactory1_EnumAdapters1((IDXGIFactory1 *) factory, 0, &fallback);
+        if (FAILED(fallback_hr)) {
+            ERROR("Failed to enum DXVK DXGI adapter by LUID %lx-%lx: 0x%x (fallback: 0x%x)",
+                  adapter->luid.HighPart, adapter->luid.LowPart, hr, fallback_hr);
+            IDXGIFactory4_Release(factory);
+            return fallback_hr;
+        }
+        INFO("%s: LUID mismatch, using first DXVK adapter %p", __FUNCTION__, fallback);
+        device->adapter = (IDXGIAdapter *) fallback;
     }
     INFO("%s: DXVK adapter=%p", __FUNCTION__, device->adapter);
     IDXGIFactory4_Release(factory);
