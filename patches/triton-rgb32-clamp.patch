              tritonMsaaFamilyQuality(pD, Format, 4) > 0)
         *pOut |= D3D10_DDI_FORMAT_SUPPORT_MULTISAMPLE_LOAD;
 
+    /* D3D11 does not allow the R32G32B32 family as a render or MSAA target.
+     * Vulkan drivers may still report color-attachment support for them; the
+     * D3D11 runtime rejects that during device finalization with
+     * DXGI_ERROR_DRIVER_INTERNAL_ERROR (0x887A0020). */
+    if (Format == DXGI_FORMAT_R32G32B32_TYPELESS ||
+        Format == DXGI_FORMAT_R32G32B32_FLOAT ||
+        Format == DXGI_FORMAT_R32G32B32_UINT ||
+        Format == DXGI_FORMAT_R32G32B32_SINT) {
+        *pOut &= ~(D3D10_DDI_FORMAT_SUPPORT_RENDERTARGET |
+                   D3D10_DDI_FORMAT_SUPPORT_BLENDABLE |
+                   D3D10_DDI_FORMAT_SUPPORT_MULTISAMPLE_RENDERTARGET |
+                   D3D10_DDI_FORMAT_SUPPORT_MULTISAMPLE_LOAD);
+    }
+
     TR_LOG("CheckFormatSupport fmt=%u -> ddi=0x%08x (host s1=0x%08x s2=0x%08x)",
            (UINT)Format, *pOut, s1, s2);
