diff --git a/src/dxvk/dxvk_umd_wait.h b/src/dxvk/dxvk_umd_wait.h
new file mode 100644
index 0000000..2fa4e8d
--- /dev/null
+++ b/src/dxvk/dxvk_umd_wait.h
@@ -0,0 +1,53 @@
+#pragma once
+
+#include <cstdint>
+
+namespace dxvk {
+
+  /**
+   * \brief Droid-VM UMD wait policy
+   *
+   * The virtio host renderer can kill a GPU context (tiler heap reclaim on
+   * Mali) without the transport ever reporting an error: submissions still
+   * succeed, but the fences they refer to are never signalled.  Every
+   * unbounded vkWaitSemaphores / condition variable wait below would then
+   * block the D3D11 caller forever.
+   *
+   * All such waits are funnelled through the deadline returned by
+   * umdWaitTimeoutMs().  When a deadline expires the device is latched as
+   * lost and the UMD layer turns that into
+   * DXGI_ERROR_DEVICE_REMOVED for the D3D11 runtime.
+   */
+
+  /**
+   * \brief Wait deadline in milliseconds
+   *
+   * DROIDVM_UMD_WAIT_TIMEOUT_MS overrides the default of 3000 ms.
+   * A value of 0 restores the legacy unbounded behaviour.
+   */
+  uint32_t umdWaitTimeoutMs();
+
+  /**
+   * \brief Wait deadline in nanoseconds, 0 if unbounded
+   */
+  uint64_t umdWaitTimeoutNs();
+
+  /**
+   * \brief Checks whether the process-wide device lost latch is set
+   */
+  bool umdDeviceLost();
+
+  /**
+   * \brief Latches device loss and notifies the UMD layer once
+   */
+  void umdMarkDeviceLost(const char* reason);
+
+  /**
+   * \brief Installs the UMD notification callback
+   *
+   * The callback is run exactly once, right after the latch is set, from
+   * whichever thread detected the timeout.
+   */
+  void umdSetDeviceLostCallback(void (*callback)(void* ctx), void* ctx);
+
+}
