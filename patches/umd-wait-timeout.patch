diff --git a/wait_policy.c b/wait_policy.c
new file mode 100644
index 0000000..28ef312
--- /dev/null
+++ b/wait_policy.c
@@ -0,0 +1,217 @@
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "wait_policy.h"
+
+#include "adapter.h"
+#include "device.h"
+
+/* Droid-VM UMD bounded wait policy.
+ *
+ * Everything that waits for the GPU or the host used to wait without a
+ * deadline.  When the host kills a CU group the virtio fences stop advancing
+ * but the KMD keeps returning success, so those waits never returned and the
+ * app hung on its first draw.  All of them now share one deadline; the first
+ * expiry latches the device as removed and is reported to the D3D11 runtime.
+ *
+ * DROIDVM_UMD_WAIT_TIMEOUT_MS
+ *   0        -> legacy behaviour, unbounded waits, no latch
+ *   unset    -> 3000 ms
+ *   <n>      -> n milliseconds (clamped to 10 min) */
+
+#define DROIDVM_DEFAULT_WAIT_TIMEOUT_MS 3000u
+#define DROIDVM_MAX_WAIT_TIMEOUT_MS     600000u
+#define DROIDVM_MAX_TRACKED_DEVICES     8
+
+static volatile LONG g_wait_timeout_ms = -1;   /* -1: not read yet */
+static volatile LONG g_device_removed;
+static volatile LONG g_timeout_reported;
+static volatile LONG g_registry_ready;
+
+static INIT_ONCE g_registry_once = INIT_ONCE_STATIC_INIT;
+static CRITICAL_SECTION g_registry_lock;
+static void *g_devices[DROIDVM_MAX_TRACKED_DEVICES];
+
+/* implemented in dxvk.cpp next to the other DXVK shims */
+extern void DXVK_UmdMarkDeviceLost(void);
+extern void DXVK_UmdSetDeviceLostCallback(void (*callback)(void *ctx), void *ctx);
+
+/* Reads the policy once.  The environment is intentionally sampled on first
+ * use so a caller can set it right before creating the device. */
+uint32_t virtio_wddm_wait_timeout_ms(void) {
+    LONG cached = InterlockedCompareExchange(&g_wait_timeout_ms, 0, 0);
+    if (cached >= 0)
+        return (uint32_t) cached;
+
+    uint32_t timeout_ms = DROIDVM_DEFAULT_WAIT_TIMEOUT_MS;
+    const char *env = getenv("DROIDVM_UMD_WAIT_TIMEOUT_MS");
+
+    if (env != NULL && env[0] != '\0') {
+        char *end = NULL;
+        unsigned long parsed = strtoul(env, &end, 10);
+
+        if (end != NULL && end != env && *end == '\0' && parsed <= DROIDVM_MAX_WAIT_TIMEOUT_MS)
+            timeout_ms = (uint32_t) parsed;
+        else
+            fprintf(stderr, "droidvm-umd: ignoring invalid DROIDVM_UMD_WAIT_TIMEOUT_MS=%s\n", env);
+    }
+
+    InterlockedCompareExchange(&g_wait_timeout_ms, (LONG) timeout_ms, -1);
+    return (uint32_t) g_wait_timeout_ms;
+}
+
+bool virtio_wddm_device_removed(void) {
+    return InterlockedCompareExchange(&g_device_removed, 0, 0) != 0;
+}
+
+static void report_device_lost(VIRTIO_WDDM_Device *device) {
+    if (device == NULL || device->base.pUMCallbacks == NULL || device->base.pUMCallbacks->pfnSetErrorCb == NULL)
+        return;
+
+    /* This is the only channel a UMD has to tell the D3D11 runtime that the
+     * device is gone; from here on every D3D11 call fails with
+     * DXGI_ERROR_DEVICE_REMOVED without reaching the driver again. */
+    device->base.pUMCallbacks->pfnSetErrorCb(device->base.hRTCoreLayer, DXGI_ERROR_DEVICE_REMOVED);
+}
+
+static void on_dxvk_device_lost(void *ctx) {
+    virtio_wddm_device_lost(ctx, "DXVK wait timeout");
+}
+
+static BOOL CALLBACK init_registry(PINIT_ONCE once, PVOID param, PVOID *context) {
+    (void) once;
+    (void) param;
+    (void) context;
+
+    InitializeCriticalSection(&g_registry_lock);
+
+    /* The DXVK wait policy reports a timeout straight back here. */
+    DXVK_UmdSetDeviceLostCallback(on_dxvk_device_lost, NULL);
+
+    InterlockedExchange(&g_registry_ready, 1);
+    return TRUE;
+}
+
+static void ensure_registry(void) {
+    InitOnceExecuteOnce(&g_registry_once, init_registry, NULL, NULL);
+}
+
+void virtio_wddm_device_lost(void *dev, const char *reason) {
+    VIRTIO_WDDM_Device *device = dev;
+
+    if (InterlockedCompareExchange(&g_device_removed, 1, 0) != 0)
+        return;
+
+    if (InterlockedCompareExchange(&g_timeout_reported, 1, 0) == 0) {
+        fprintf(stderr, "droidvm-umd: fence wait timed out (%u ms), device removed\n",
+                (unsigned) virtio_wddm_wait_timeout_ms());
+        fflush(stderr);
+    }
+
+    ERROR("%s: device lost (%s)", __FUNCTION__, reason != NULL ? reason : "unknown");
+
+    ensure_registry();
+
+    void *devices[DROIDVM_MAX_TRACKED_DEVICES];
+    EnterCriticalSection(&g_registry_lock);
+    memcpy(devices, g_devices, sizeof(devices));
+    LeaveCriticalSection(&g_registry_lock);
+
+    report_device_lost(device);
+
+    for (size_t i = 0; i < DROIDVM_MAX_TRACKED_DEVICES; i++) {
+        if (devices[i] != NULL && devices[i] != dev)
+            report_device_lost(devices[i]);
+    }
+
+    /* Stop DXVK from submitting or waiting on the dead context as well. */
+    DXVK_UmdMarkDeviceLost();
+}
+
+void virtio_wddm_wait_policy_init(void *dev) {
+    virtio_wddm_wait_timeout_ms();
+    ensure_registry();
+
+    EnterCriticalSection(&g_registry_lock);
+    for (size_t i = 0; i < DROIDVM_MAX_TRACKED_DEVICES; i++) {
+        if (g_devices[i] == dev) {
+            LeaveCriticalSection(&g_registry_lock);
+            return;
+        }
+    }
+    for (size_t i = 0; i < DROIDVM_MAX_TRACKED_DEVICES; i++) {
+        if (g_devices[i] == NULL) {
+            g_devices[i] = dev;
+            break;
+        }
+    }
+    LeaveCriticalSection(&g_registry_lock);
+}
+
+void virtio_wddm_wait_policy_release(void *dev) {
+    if (InterlockedCompareExchange(&g_registry_ready, 0, 0) == 0)
+        return;
+
+    EnterCriticalSection(&g_registry_lock);
+    for (size_t i = 0; i < DROIDVM_MAX_TRACKED_DEVICES; i++) {
+        if (g_devices[i] == dev)
+            g_devices[i] = NULL;
+    }
+    LeaveCriticalSection(&g_registry_lock);
+}
+
+DWORD virtio_wddm_wait_handle(HANDLE handle, DWORD legacy_timeout_ms) {
+    uint32_t timeout_ms = virtio_wddm_wait_timeout_ms();
+
+    if (timeout_ms == 0)
+        return WaitForSingleObject(handle, legacy_timeout_ms);
+
+    if (virtio_wddm_device_removed())
+        return WAIT_TIMEOUT;
+
+    return WaitForSingleObject(handle, timeout_ms);
+}
+
+int virtio_wddm_wait_paging_fence(void *dev, UINT64 fence_value) {
+    VIRTIO_WDDM_Device *device = dev;
+
+    if (device == NULL || device->paging.fence_value == NULL)
+        return 0;
+
+    uint32_t timeout_ms = virtio_wddm_wait_timeout_ms();
+    if (timeout_ms == 0)
+        return 0;
+
+    /* FenceValueCPUVirtualAddress from CreatePagingQueueCb: the KMD writes the
+     * current value here, so the wait can be bounded without another kernel
+     * round trip.  Monitored fence values are 64 bit and always aligned. */
+    volatile UINT64 *monitor = (volatile UINT64 *) device->paging.fence_value;
+    ULONGLONG deadline = GetTickCount64() + timeout_ms;
+
+    while (*monitor < fence_value) {
+        if (virtio_wddm_device_removed())
+            return -1;
+
+        if (GetTickCount64() >= deadline) {
+            virtio_wddm_device_lost(device, "paging fence");
+            return -1;
+        }
+
+        Sleep(1);
+    }
+
+    return 1;
+}
+
+bool virtio_wddm_check_device_removed(void *dev) {
+    if (!virtio_wddm_device_removed())
+        return false;
+
+    report_device_lost(dev);
+    return true;
+}
diff --git a/wait_policy.h b/wait_policy.h
new file mode 100644
index 0000000..e964d9b
--- /dev/null
+++ b/wait_policy.h
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <windows.h>
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* DXGI_ERROR_DEVICE_REMOVED, spelled out so the exact value the harness
+ * expects (0x887A0005) does not depend on which SDK headers are installed. */
+#ifndef DXGI_ERROR_DEVICE_REMOVED
+#define DXGI_ERROR_DEVICE_REMOVED ((HRESULT) 0x887A0005L)
+#endif
+
+/* Unified bounded wait policy for GPU/host completion.
+ *
+ * The host renderer can kill a GPU context (Mali tiler heap reclaim) without
+ * the virtio transport ever reporting an error: submits still succeed, the
+ * fences are simply never signalled.  Every wait for GPU progress therefore
+ * has to be bounded, and the first timeout turns into
+ * DXGI_ERROR_DEVICE_REMOVED for the D3D11 runtime. */
+
+/* Wait deadline in milliseconds.  DROIDVM_UMD_WAIT_TIMEOUT_MS overrides the
+ * 3000 ms default; 0 restores the previous unbounded behaviour. */
+uint32_t virtio_wddm_wait_timeout_ms(void);
+
+/* Process-wide latch, set by the first expired deadline. */
+bool virtio_wddm_device_removed(void);
+
+/* Registers the runtime device so a lost device can be reported through
+ * pfnSetErrorCb, and hooks the DXVK wait policy.  Idempotent. */
+void virtio_wddm_wait_policy_init(void *device);
+
+/* Drops the device from the notification set (destroy_device). */
+void virtio_wddm_wait_policy_release(void *device);
+
+/* Latches device removal, prints the stderr diagnostic exactly once per
+ * process and reports DXGI_ERROR_DEVICE_REMOVED to the runtime.  `device` may
+ * be NULL when the caller has no device at hand. */
+void virtio_wddm_device_lost(void *device, const char *reason);
+
+/* Bounded WaitForSingleObject for GPU completion events.  Returns
+ * WAIT_OBJECT_0 on success, WAIT_TIMEOUT when the deadline expired and
+ * WAIT_FAILED on error. */
+DWORD virtio_wddm_wait_handle(HANDLE handle, DWORD legacy_timeout_ms);
+
+/* Bounded poll of the CPU visible paging monitored fence, replacing the
+ * unbounded D3DDDICB_WAITFORSYNCHRONIZATIONOBJECTFROMCPU wait.  Returns
+ * 1 when the fence reached `fence_value`, 0 when the policy is disabled or no
+ * monitored fence is available (caller must use the legacy wait) and -1 when
+ * the deadline expired (device already latched as removed). */
+int virtio_wddm_wait_paging_fence(void *device, UINT64 fence_value);
+
+/* DDI prologue: returns true (and reports the removal) once the latch is set,
+ * so the DDI can fail without entering the kernel again. */
+bool virtio_wddm_check_device_removed(void *device);
