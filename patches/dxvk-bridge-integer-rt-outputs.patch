+  void DxvkIrShader::rewriteOutputTypes(
+          dxbc_spv::ir::Builder&                  builder,
+    const std::array<uint8_t, MaxNumRenderTargets>& rtTypes) {
+    using namespace dxbc_spv;
+
+    // Find output declarations whose type does not match the numeric
+    // class of the render target format that they are written to.
+    std::vector<ir::SsaDef> outputDecls;
+
+    auto declarations = builder.getDeclarations();
+
+    for (auto iter = declarations.first; iter != declarations.second; iter++) {
+      if (iter->getOpCode() != ir::OpCode::eDclOutput)
+        continue;
+
+      uint32_t location = uint32_t(iter->getOperand(iter->getFirstLiteralOperandIndex()));
+
+      if (location >= rtTypes.size() || !rtTypes[location])
+        continue;
+
+      ir::ScalarType scalarType = rtTypes[location] == 1u
+        ? ir::ScalarType::eU32
+        : ir::ScalarType::eI32;
+
+      if (iter->getType().getBaseType() != scalarType)
+        outputDecls.push_back(iter->getDef());
+    }
+
+    for (auto decl : outputDecls) {
+      ir::Op declOp = builder.getOp(decl);
+
+      ir::Type oldType = declOp.getType();
+
+      uint32_t location = uint32_t(declOp.getOperand(declOp.getFirstLiteralOperandIndex()));
+      ir::ScalarType scalarType = rtTypes[location] == 1u
+        ? ir::ScalarType::eU32
+        : ir::ScalarType::eI32;
+
+      ir::Type newType(scalarType, oldType.getVectorSize());
+
+      {
+        static std::mutex loggedTypesMutex;
+        static std::set<std::string> loggedTypes;
+
+        std::lock_guard<std::mutex> lock(loggedTypesMutex);
+
+        if (loggedTypes.insert(str::format(m_debugName, ":", location,
+            ":", uint32_t(oldType.getBaseType()), "->", uint32_t(scalarType))).second) {
+          Logger::info(str::format("DXVK int RT bridge: ", m_debugName,
+            ": output ", location, " type ", uint32_t(oldType.getBaseType()),
+            " -> ", uint32_t(scalarType)));
+        }
+      }
+
+      // Change the component type of the output declaration
+      declOp.setType(newType);
+      builder.rewriteOp(decl, declOp);
+
+      // Reinterpret all values written to or read from the output
+      std::vector<ir::SsaDef> uses;
+      builder.getUses(decl, uses);
+
+      for (auto use : uses) {
+        ir::Op op = builder.getOp(use);
+
+        if (op.getOpCode() == ir::OpCode::eOutputStore) {
+          uint32_t valueIndex = op.getOperandCount() - 1u;
+
+          ir::SsaDef value = ir::SsaDef(op.getOperand(valueIndex));
+          ir::Type valueType = builder.getOp(value).getType();
+
+          if (valueType.getBaseType() != scalarType) {
+            ir::SsaDef cast = builder.addBefore(use, ir::Op::Cast(
+              ir::Type(scalarType, valueType.getVectorSize()), value));
+
+            op.setOperand(valueIndex, cast);
+            builder.rewriteOp(use, op);
+          }
+        } else if (op.getOpCode() == ir::OpCode::eOutputLoad) {
+          ir::Type loadType = op.getType();
+
+          if (loadType.getBaseType() != scalarType) {
+            ir::SsaDef load = builder.addBefore(use, ir::Op::OutputLoad(
+              ir::Type(scalarType, loadType.getVectorSize()), decl, ir::SsaDef(op.getOperand(1u))));
+
+            builder.rewriteOp(use, ir::Op::Cast(loadType, load));
+          }
+        }
+      }
+    }
+  }
+
+
   dxbc_spv::ir::IoOutputSwizzle DxvkIrShader::convertOutputSwizzle(VkComponentMapping mapping) {
     dxbc_spv::ir::IoOutputSwizzle result;
     result.x = convertOutputComponent(mapping.r, dxbc_spv::ir::IoOutputComponent::eX);
